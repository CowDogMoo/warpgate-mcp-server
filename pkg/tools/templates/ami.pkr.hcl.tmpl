#########################################################################################
# {{.TemplateName}} AMI packer template
#
# Description: {{.Description}}
#########################################################################################
# AWS AMI source configuration
source "amazon-ebs" "amd64" {
  ami_name      = "{{.TemplateName}}-{{"{{"}}timestamp{{"}}"}}"
  instance_type = var.instance_type
  region        = var.ami_region
  ssh_username  = var.ssh_username
  ssh_timeout   = var.ssh_timeout

  source_ami_filter {
    filters = {
      name                = "ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"
      root-device-type    = "ebs"
      virtualization-type = "hvm"
    }
    most_recent = true
    owners      = ["099720109477"] # Canonical
  }

  launch_block_device_mappings {
    device_name = "/dev/sda1"
    volume_size = var.disk_size
    volume_type = "gp3"
    delete_on_termination = true
  }

  tags = {
    Name = "{{.TemplateName}}"
    Built_By = "Packer"
    Built_At = "{{"{{"}}timestamp{{"}}"}}"
  }
}

build {
  name = "{{.TemplateName}}-ami"
  sources = [
    "source.amazon-ebs.amd64"
  ]

  # Add your provisioning steps here
  provisioner "shell" {
    inline = [
      "echo 'Add your AMI provisioning commands here'",
      "sudo apt-get update",
      "# sudo apt-get install -y --no-install-recommends <your-packages>",
    ]
  }

  # Aggressive cleanup to minimize AMI size
  provisioner "shell" {
    inline = [
      # Clean up Ansible/Packer runtime artifacts
      "sudo rm -rf /home/$${var.ssh_username}/.ansible || true",
      "sudo rm -rf /root/.ansible || true",
      "sudo rm -rf /tmp/ansible* /tmp/packer* || true",

      # Ensure no running processes are holding files open
      "sync",

      # Clear bash history and shell artifacts
      "rm -f /home/$${var.ssh_username}/.bash_history || true",
      "rm -f /home/$${var.ssh_username}/.wget-hsts || true",
      "sudo rm -f /root/.bash_history || true",
      "history -c 2>/dev/null || true",

      # Remove Python development packages (keep core Python if needed)
      "sudo apt-get remove -y --purge python3-dev python3-pip python3-setuptools python3-wheel python3-distutils || true",

      # Remove development tools
      "sudo apt-get remove -y --purge gcc* g++* cpp* build-essential libtool cmake dpkg-dev *-dev || true",

      # Clean Python artifacts
      "sudo find /usr/lib/python3* -type d -name '__pycache__' -exec rm -rf {{"{{"}} {{"}}"}} + 2>/dev/null || true",
      "sudo find /usr/lib/python3* -type f \\( -name '*.pyc' -o -name '*.pyo' \\) -delete 2>/dev/null || true",
      "sudo find /usr/lib/python3* -type d \\( -name 'test' -o -name 'tests' \\) -exec rm -rf {{"{{"}} {{"}}"}} + 2>/dev/null || true",

      # Remove documentation and man pages
      "sudo rm -rf /usr/share/doc /usr/share/man /usr/share/info || true",
      "sudo find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en*' -exec rm -rf {{"{{"}} {{"}}"}} + 2>/dev/null || true",

      # Remove caches
      "rm -rf /home/$${var.ssh_username}/.cache || true",
      "sudo rm -rf /root/.cache || true",
      "sudo rm -rf /var/cache/* /var/tmp/* /tmp/* || true",

      # Truncate logs
      "sudo find /var/log -type f -exec truncate -s 0 {{"{{"}} {{"}}"}} \\; 2>/dev/null || true",

      # Final APT cleanup
      "sudo apt-get autoremove -y --purge || true",
      "sudo apt-get autoclean -y || true",
      "sudo apt-get clean || true",
      "sudo rm -rf /var/lib/apt/lists/* || true",
      "sudo rm -rf /var/cache/apt/* || true",

      # Ensure clean exit
      "exit 0"
    ]
  }
}
